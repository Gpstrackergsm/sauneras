<section class="sauneras-section sauneras-section-warm color-{{ section.settings.color_scheme }}" id="faq">
  <div class="sauneras-container" style="max-width: 860px;">
    <div class="sauneras-header-center">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-faq-list">
      {%- for block in section.blocks -%}
        <div class="sauneras-faq-item" {{ block.shopify_attributes }}>
          <button 
            type="button" 
            class="sauneras-faq-btn" 
            onclick="const content = this.nextElementSibling; const isExpanded = content.style.display === 'block'; content.style.display = isExpanded ? 'none' : 'block'; this.querySelector('span.faq-toggle').innerText = isExpanded ? '+' : '−';"
            aria-expanded="false"
          >
            <span>{{ block.settings.question }}</span>
            <span class="faq-toggle" style="font-size: 1.4rem; color: #CF6E3C; line-height: 1;">+</span>
          </button>
          <div class="sauneras-faq-content" style="display: none;">
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "CLEAR ANSWERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Everything you need to know about setting up, operating, and enjoying your Sauneras portable spa."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How hot does the Sauneras steam box get?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "The Sauneras high-output steam generator delivers temperatures up to 135°F - 145°F (57°C - 63°C) with 9-15 adjustable digital heat levels. Due to 100% steam humidity, this produces an intense, deep thermal sweat comparable to a 190°F traditional dry sauna."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sauneras FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How hot does the Sauneras steam box get?",
            "answer": "The Sauneras high-output steam generator reaches up to 135°F - 145°F (57°C - 63°C) across 9-15 adjustable heat levels. Because steam retains latent heat, 140°F in high humidity induces a profound, deep sweat comparable to a dry 190°F Finnish sauna."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does it take to set up and start steaming?",
            "answer": "The tent uses a pop-up frame that expands in under 60 seconds. Simply place the foldable chair and sweat mat inside, fill the steamer with clean water, connect the insulated hose, and plug it in. Dense, aromatic steam begins circulating in just 5-8 minutes."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I add essential oils or herbal botanicals?",
            "answer": "Yes! Every Sauneras system includes a dedicated herbal infusion diffuser box. You can drop natural essential oils (such as eucalyptus, peppermint, lavender) or fresh dried herbs to transform your session into an authentic therapeutic aromatherapy spa."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I clean and store it after a sweat session?",
            "answer": "The multi-layer Oxford waterproof lining repels moisture. Simply wipe down the floor mat and interior walls with a dry microfiber cloth or antibacterial spray. Leave the zipper open for 10 minutes to dry completely, then fold it flat into its included carry duffle bag."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is the electrical consumption & safety certification?",
            "answer": "Sauneras plugs into standard 110V/120V (or 220V/240V international) household wall outlets. At 1000W-1600W, a typical 25-minute session costs less than $0.15 in electricity. It features automatic dry-burn shut-off, high-pressure relief valve, and anti-leak certification."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is your return policy and warranty?",
            "answer": "Every Sauneras comes with our 30-Day In-Home Money Back Guarantee. If you don't feel noticeably more relaxed and rejuvenated, return it for a prompt refund. You also receive a full 1-Year Manufacturer Warranty on the generator and frame."
          }
        }
      ]
    }
  ]
}
{% endschema %}
