<section class="sauneras-section color-{{ section.settings.color_scheme }}">
  <div class="sauneras-container">
    <div class="sauneras-guarantee-box">
      <div class="sauneras-guarantee-badge-img">
        <svg viewBox="0 0 100 100" width="100" height="100" fill="none">
          <circle cx="50" cy="50" r="45" stroke="#CF6E3C" stroke-width="3" stroke-dasharray="4,4"/>
          <circle cx="50" cy="50" r="38" fill="#1F362B"/>
          <path d="M35 50 L45 60 L65 40" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="50" y="76" fill="#F79A63" font-size="9" font-weight="bold" text-anchor="middle" font-family="sans-serif">30-DAY TRIAL</text>
        </svg>
      </div>

      <div>
        <h3 style="font-size: 1.6rem; font-weight: 800; color: #1F362B; margin: 0 0 8px;">
          {{ section.settings.heading }}
        </h3>
        <p style="font-size: 1rem; color: #5B6A63; margin: 0; line-height: 1.6;">
          {{ section.settings.text }}
        </p>
      </div>

      <div>
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="sauneras-btn-primary" style="white-space: nowrap;">
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Guarantee Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try Sauneras Risk-Free For 30 Days"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sweat in the comfort of your home for a full month. If you aren't feeling deeper relaxation, better sleep, and renewed energy, return it for a 100% prompt refund. No hassles."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim Your Sauna"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Sauneras Guarantee Banner"
    }
  ]
}
{% endschema %}
