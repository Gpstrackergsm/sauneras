<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="reviews">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <!-- Social proof stats banner -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 40px; background: rgba(31, 54, 43, 0.04); padding: 24px; border-radius: 16px; text-align: center;">
      <div>
        <div style="font-size: 2rem; font-weight: 800; color: #1F362B;">98%</div>
        <div style="font-size: 0.9rem; color: #5B6A63; margin-top: 4px;">Reported deeper, uninterrupted sleep</div>
      </div>
      <div>
        <div style="font-size: 2rem; font-weight: 800; color: #1F362B;">94%</div>
        <div style="font-size: 0.9rem; color: #5B6A63; margin-top: 4px;">Experienced reduced muscle & joint pain</div>
      </div>
      <div>
        <div style="font-size: 2rem; font-weight: 800; color: #1F362B;">15,000+</div>
        <div style="font-size: 0.9rem; color: #5B6A63; margin-top: 4px;">Sauneras sessions enjoyed worldwide</div>
      </div>
      <div>
        <div style="font-size: 2rem; font-weight: 800; color: #1F362B;">4.9 / 5.0</div>
        <div style="font-size: 0.9rem; color: #5B6A63; margin-top: 4px;">Average customer satisfaction rating</div>
      </div>
    </div>

    <div class="sauneras-benefits-grid">
      {%- for block in section.blocks -%}
        <div class="sauneras-benefit-card" {{ block.shopify_attributes }}>
          <div style="display: flex; gap: 4px; color: #CF6E3C; margin-bottom: 12px;">
            {%- for i in (1..5) -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {%- endfor -%}
          </div>

          <h4 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 10px; color: #1A2420;">
            "{{ block.settings.review_title }}"
          </h4>

          <p class="sauneras-card-desc" style="flex-grow: 1;">
            {{ block.settings.review_body }}
          </p>

          <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 20px; padding-top: 14px; border-top: 1px solid #ECE7E1;">
            <div>
              <div style="font-weight: 700; font-size: 0.95rem; color: #1A2420;">
                {{ block.settings.author_name }}
              </div>
              <div style="font-size: 0.8rem; color: #2D7A4D; display: flex; align-items: center; gap: 4px;">
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Verified Buyer
              </div>
            </div>
            <div style="font-size: 0.8rem; color: #8A9791;">
              {{ block.settings.product_purchased }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "COMMUNITY STORIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Sweats. Real Transformation."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hear how athletes, busy parents, and wellness lovers integrated Sauneras into their daily recovery ritual."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "review_title",
          "label": "Title",
          "default": "Best purchase I've made in years"
        },
        {
          "type": "textarea",
          "id": "review_body",
          "label": "Review Text",
          "default": "I was skeptical about a portable sauna, but it gets crazy hot in just 7 minutes! The sweat is unreal and my chronic lower back stiffness has completely vanished."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Sarah M., Austin TX"
        },
        {
          "type": "text",
          "id": "product_purchased",
          "label": "Product",
          "default": "Sauneras Deluxe Steam Spa"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sauneras Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review_title": "Better than the gym sauna by miles!",
            "review_body": "No more waiting in line at the gym or sitting in dirty communal saunas. I put eucalyptus oil in the steamer, pop my arms out to hold my Kindle, and sweat for 25 mins every evening. Sleeping like a baby!",
            "author_name": "Marcus D.",
            "product_purchased": "Sauneras Pro 1600W Box"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_title": "Unbelievable sweat and so easy to pack up",
            "review_body": "Living in a small apartment, I didn't think I could have a sauna. It literally folds flat behind my wardrobe when not in use. Heats up to 135°F fast and the fabric quality is thick and durable.",
            "author_name": "Elena R.",
            "product_purchased": "Sauneras Home Steam Kit"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_title": "Game changer for marathon recovery",
            "review_body": "As a runner, my joints take a beating. Doing 20 minutes in my Sauneras right after my long runs has cut my delayed muscle soreness in half. Worth every single penny.",
            "author_name": "David K.",
            "product_purchased": "Sauneras Infrared Pro"
          }
        }
      ]
    }
  ]
}
{% endschema %}
