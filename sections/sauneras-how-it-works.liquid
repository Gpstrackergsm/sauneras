<section class="sauneras-section sauneras-section-warm color-{{ section.settings.color_scheme }}" id="how-it-works">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-steps-grid">
      <div class="sauneras-step-card">
        <div class="sauneras-step-num">1</div>
        <h3 class="sauneras-card-title">Avaa & Pystytä 60 sekunnissa</h3>
        <p class="sauneras-card-desc">
          Ota monikerroksinen lämpöeristetty saunateltta esiin kantokassistaan. Se avautuu käyttövalmiiksi alle minuutissa. Aseta mukana tuleva taitettava saunatuoli sisälle.
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">2</div>
        <h3 class="sauneras-card-title">Valitse Lämpötila (Jopa 65 °C)</h3>
        <p class="sauneras-card-desc">
          Kytke laite tavalliseen 230V suomalaiseen pistorasiaan. Säädä haluamasi lämpötila ja ajastin langattomalla kaukosäätimellä. Voit myös lisätä eukalyptus- tai koivutuoksua.
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">3</div>
        <h3 class="sauneras-card-title">Hikoile, Rentoudu & Palaudu</h3>
        <p class="sauneras-card-desc">
          Astu sisään ja sulje vetoketju. Käsiaukkojen ansiosta voit lukea kirjaa tai käyttää puhelinta. 15–25 minuutin jälkeen tunnet olosi kevyeksi, virkeäksi ja syvärentoutuneeksi.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="{{ section.settings.button_link | default: '#single-product' }}" class="sauneras-btn-primary">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras How It Works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "VAIVATON KOTIKYLPYLÄ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oma Kotisauna Käyttövalmiina 3 Helpossa Vaiheessa"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Suunniteltu suomalaisiin kerrostaloasuntoihin, omakotitaloihin ja mökeille. Ei remonttia, ei putkitöitä eikä työkaluja."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Tilaa Sauneras™ Kotiin"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Sauneras How It Works"
    }
  ]
}
{% endschema %}
