<section class="sauneras-section sauneras-section-warm color-{{ section.settings.color_scheme }}" id="how-it-works">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-steps-grid">
      <div class="sauneras-step-card">
        <div class="sauneras-step-num">1</div>
        <h3 class="sauneras-card-title">Helppo Modulaarinen Kokoaminen</h3>
        <p class="sauneras-card-desc">
          Valmiit luonnonpuuelementit napsahtavat paikalleen nopeasti ilman erikoistyökaluja, putkitöitä tai rakennuslupia. Kompakti muotoilu mahtuu kylpyhuoneeseen, makuuhuoneeseen tai lasitetulle parvekkeelle.
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">2</div>
        <h3 class="sauneras-card-title">Kytke 230V Pistorasiaan & Aseta Lämpö</h3>
        <p class="sauneras-card-desc">
          Liitä virtajohto tavalliseen suomalaiseen 230V pistorasiaan (ei vaadi voimavirtaa). Valitse haluamasi lämpötila ja aika digitaalisesta ohjauspaneelista — 1350W infrapunalämmittimet lämpenevät muutamassa minuutissa.
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">3</div>
        <h3 class="sauneras-card-title">Nauti Syvälämmöstä & Palaudu</h3>
        <p class="sauneras-card-desc">
          Istu alas luonnonpuiselle lauteelle, kuuntele musiikkia tai lue kirjaa. Kaukoinfrapunasäteily lämmittää lihakset ja nivelet syvältä, poistaa kuona-aineita ja valmistaa kehosi syvään yöuneen.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="{{ section.settings.button_link | default: '#single-product' }}" class="sauneras-btn-primary">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras How It Works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "VAIVATON KOTIKYLPYLÄ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oma Puinen Infrapunasauna Käyttövalmiina 3 Vaiheessa"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Suunniteltu suomalaisiin kerrostaloasuntoihin, omakotitaloihin ja mökeille. Ei remonttia, ei putkitöitä eikä voimavirtaa."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Tilaa Sauneras™ Kotiin"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Sauneras How It Works"
    }
  ]
}
{% endschema %}
