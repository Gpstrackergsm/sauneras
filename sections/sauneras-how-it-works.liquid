<section class="sauneras-section sauneras-section-warm color-{{ section.settings.color_scheme }}" id="how-it-works">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-steps-grid">
      <div class="sauneras-step-card">
        <div class="sauneras-step-num">1</div>
        <h3 class="sauneras-card-title">Unfold & Pop Up</h3>
        <p class="sauneras-card-desc">
          Remove the multi-layer insulated thermal tent from its compact travel bag. It springs to life in under 60 seconds. Set up the included reinforced comfort chair inside.
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">2</div>
        <h3 class="sauneras-card-title">Fill & Set Temperature</h3>
        <p class="sauneras-card-desc">
          Fill the 1000W-1600W smart steam generator with clean water. Add eucalyptus oil or herbal botanicals into the herbal box. Use the wireless remote to dial in your ideal heat (up to 140°F).
        </p>
      </div>

      <div class="sauneras-step-card">
        <div class="sauneras-step-num">3</div>
        <h3 class="sauneras-card-title">Sweat, Detox & Relax</h3>
        <p class="sauneras-card-desc">
          Step in and zip up. Dual front arm openings let you read, hold your phone, or sip hydration. After 15–25 minutes, step out feeling refreshed, lighter, and completely renewed.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="sauneras-btn-primary">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras How It Works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "EFFORTLESS WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spa Day at Home in 3 Simple Steps"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Designed for modern living spaces. No dedicated electrical wiring, no permanent plumbing, and zero tools needed."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Find Your Sauneras Box"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Sauneras How It Works"
    }
  ]
}
{% endschema %}
