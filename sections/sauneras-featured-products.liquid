<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="products">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-benefits-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
      {%- for block in section.blocks -%}
        <div class="sauneras-benefit-card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;" {{ block.shopify_attributes }}>
          <!-- Product image container -->
          <div style="position: relative; width: 100%; aspect-ratio: 1 / 1; background: #EFEBE4; overflow: hidden;">
            {%- if block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 600 }}" 
                alt="{{ block.settings.title | escape }}" 
                width="600" 
                height="600" 
                loading="lazy" 
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- else -%}
              <img 
                src="{{ block.settings.image_url }}" 
                alt="{{ block.settings.title | escape }}" 
                width="600" 
                height="600" 
                loading="lazy" 
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- endif -%}

            {%- if block.settings.badge != blank -%}
              <span style="position: absolute; top: 12px; left: 12px; background: #CF6E3C; color: #FFFFFF; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                {{ block.settings.badge }}
              </span>
            {%- endif -%}
          </div>

          <!-- Product details -->
          <div style="padding: 22px; display: flex; flex-direction: column; flex-grow: 1;">
            <div style="display: flex; align-items: center; gap: 4px; color: #CF6E3C; margin-bottom: 8px;">
              {%- for i in (1..5) -%}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {%- endfor -%}
              <span style="font-size: 0.8rem; color: #738079; margin-left: 4px;">({{ block.settings.rating_count }})</span>
            </div>

            <h3 style="font-size: 1.1rem; font-weight: 700; color: #1A2420; margin: 0 0 8px; line-height: 1.35;">
              {{ block.settings.title }}
            </h3>

            <p style="font-size: 0.88rem; color: #5B6A63; line-height: 1.5; margin: 0 0 16px; flex-grow: 1;">
              {{ block.settings.subtitle }}
            </p>

            <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
              <span style="font-size: 1.35rem; font-weight: 800; color: #1F362B;">
                {{ block.settings.price }}
              </span>
              {%- if block.settings.compare_price != blank -%}
                <span style="font-size: 0.95rem; color: #8F9D96; text-decoration: line-through;">
                  {{ block.settings.compare_price }}
                </span>
                <span style="font-size: 0.8rem; font-weight: 700; color: #2E7D32;">
                  SAVE {{ block.settings.savings }}
                </span>
              {%- endif -%}
            </div>

            <a 
              href="{{ block.settings.product_link | default: routes.all_products_collection_url }}" 
              class="sauneras-btn-primary" 
              style="width: 100%; text-align: center; justify-content: center; padding: 12px 20px; font-size: 0.95rem;"
            >
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
