<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="comparison">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-comparison-wrap">
      <div style="overflow-x: auto;">
        <table class="sauneras-table">
          <thead>
            <tr>
              <th style="width: 34%;">Feature / Consideration</th>
              <th class="highlight-col" style="width: 33%;">
                <div style="font-size: 1.25rem; font-weight: 800; color: #1F362B;">
                  Sauneras Portable Spa
                </div>
                <div style="font-size: 0.85rem; font-weight: normal; color: #CF6E3C; margin-top: 4px;">
                  Best Value & Convenience
                </div>
              </th>
              <th style="width: 33%; color: #5B6A63;">
                Traditional Wood Cabin
                <div style="font-size: 0.85rem; font-weight: normal; color: #8C9993; margin-top: 4px;">
                  Permanent Installation
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Price Point</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  $179 - $349 (One-time)
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  $4,500 - $12,000+
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Setup Time</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Under 60 Seconds (Pop-up)
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Weeks of Contractor Work
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Space Requirement</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Folds flat into a closet bag
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Requires dedicated entire room
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Electrical / Wiring</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Standard 110V/220V wall outlet
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Costly 240V dedicated sub-panel
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Warm-up Speed</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Ready in 5-8 minutes
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  35-50 minutes
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Aromatherapy & Herbal Steam</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Included herbal infusion pod
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Not recommended / water on rocks
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "SMART SANCTUARY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Sauneras Advantage"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "All the therapeutic benefits of a traditional luxury Finnish sauna, without the multi-thousand dollar investment or home renovations."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Sauneras Comparison"
    }
  ]
}
{% endschema %}
