<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="comparison">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      <div class="sauneras-badge">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-comparison-wrap">
      <div style="overflow-x: auto;">
        <table class="sauneras-table">
          <thead>
            <tr>
              <th style="width: 34%;">Ominaisuus</th>
              <th class="highlight-col" style="width: 33%;">
                <div style="font-size: 1.25rem; font-weight: 800; color: #1F362B;">
                  Sauneras™ Kotisauna
                </div>
                <div style="font-size: 0.85rem; font-weight: normal; color: #CF6E3C; margin-top: 4px;">
                  Paras hinta-laatusuhde & helppous
                </div>
              </th>
              <th style="width: 33%; color: #5B6A63;">
                Perinteinen remonttisauna
                <div style="font-size: 0.85rem; font-weight: normal; color: #8C9993; margin-top: 4px;">
                  Kiinteä asennus
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Hankintahinta</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  599 € Black Friday -tarjous (Norm. 999 € • Säästä 400 €)
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  5 000 € – 15 000 €+
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Käyttöönotto</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Alle 60 sekuntia (Pop-up-rakenne)
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Viikkojen remontti ja rakennusluvat
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Tilantarve & Säilytys</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Taittuu litteäksi kaappiin tai sängyn alle
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Vaatii kokonaisen erillisen huoneen
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Sähköliitäntä & Kulutus</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Tavallinen 230V suomalainen pistorasia (n. 0,15 € / kerta)
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Voimavirta-asennus & korkea sähkölasku
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Lämpenemisaika</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Valmis 5–8 minuutissa
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  45–60 minuuttia
                </span>
              </td>
            </tr>
            <tr>
              <td><strong>Aromaterapia & Yrttihöyry</strong></td>
              <td class="highlight-col">
                <span class="sauneras-check-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Sisäänrakennettu tuoksu- ja yrttisäiliö
                </span>
              </td>
              <td>
                <span class="sauneras-cross-icon">
                  <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  Ei erillistä aromidiffuusoria
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "ÄLYKÄS VALINTA SUOMALAISEEN KOTIIN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sauneras™ vs. Perinteinen Remonttisauna"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Nauti kaikista päivittäisen lämpöterapian ja hikoilun terveyshyödyistä murto-osalla perinteisen saunan kustannuksista ja sähkönkulutuksesta."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Sauneras Comparison"
    }
  ]
}
{% endschema %}
