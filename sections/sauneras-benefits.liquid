<section class="sauneras-section sauneras-section-warm color-{{ section.settings.color_scheme }}" id="benefits">
  <div class="sauneras-container">
    <div class="sauneras-header-center">
      {%- if section.settings.sub_heading != blank -%}
        <div class="sauneras-badge sauneras-badge-green">
          {{ section.settings.sub_heading }}
        </div>
      {%- endif -%}
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <div class="sauneras-benefits-grid">
      {%- for block in section.blocks -%}
        <div class="sauneras-benefit-card" {{ block.shopify_attributes }}>
          <div class="sauneras-card-icon">
            {%- case block.settings.icon -%}
              {%- when 'detox' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                </svg>
              {%- when 'muscle' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 16.5l-3 3 3 3 3-3-3-3zM18 4.5l3 3-3 3-3-3 3-3z"></path>
                  <path d="M14.5 9.5l-5 5"></path>
                  <path d="M4.5 19.5l15-15"></path>
                </svg>
              {%- when 'sleep' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              {%- when 'calorie' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
              {%- when 'setup' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            {%- endcase -%}
          </div>
          <h3 class="sauneras-card-title">{{ block.settings.title }}</h3>
          <p class="sauneras-card-desc">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Health Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "CLINICALLY PROVEN RECOVERY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why 15,000+ People Choose Sauneras Daily"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Transform your daily wellness routine with targeted hyperthermic therapy designed for maximum cellular rejuvenation and stress relief."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "detox", "label": "Detox Water Drop" },
            { "value": "muscle", "label": "Muscle & Joint" },
            { "value": "sleep", "label": "Deep Sleep Moon" },
            { "value": "calorie", "label": "Calorie Burn Flame" },
            { "value": "setup", "label": "Fast 60s Setup" },
            { "value": "safety", "label": "Smart Safety Shield" }
          ],
          "default": "detox"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Deep Cellular Detox"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Induce a profuse, purifying sweat that flushes heavy metals, environmental toxins, and clears clogged pores."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sauneras Health Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "detox",
            "title": "Deep Cellular Detox",
            "text": "Induce a profuse, purifying sweat that helps flush environmental toxins and promotes clear, radiant skin."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "muscle",
            "title": "Rapid Muscle & Joint Relief",
            "text": "Deep penetrating warmth boosts blood circulation by up to 200%, soothing stiff joints and reducing post-workout DOMS."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "calorie",
            "title": "Calorie Burn & Metabolism",
            "text": "A 20-minute session elevates heart rate mimicking moderate cardio, burning up to 400-600 calories while you unwind."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sleep",
            "title": "Restorative Sleep & Calm",
            "text": "Naturally lowers cortisol stress hormones and stimulates melatonin production for your deepest night's rest."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "setup",
            "title": "Pop-Up in 60 Seconds",
            "text": "No contractors, zero tools, and no 240V rewiring needed. Simply unfold, plug into standard wall outlet, and enjoy."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "safety",
            "title": "Smart Anti-Dry Safety",
            "text": "Equipped with intelligent dry-run auto shut-off, multi-layer thermal insulation, and low-EMF certified safety."
          }
        }
      ]
    }
  ]
}
{% endschema %}
