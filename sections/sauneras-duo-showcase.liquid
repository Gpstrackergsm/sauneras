{%- liquid
  assign mat_product = nil
  assign cabin_product = nil

  for prod in collections['all'].products
    assign p_handle = prod.handle | downcase
    assign p_title = prod.title | downcase
    if p_handle contains 'punavalo' or p_title contains 'punavalo' or p_title contains 'red light' or p_handle contains 'patja' or p_title contains 'patja'
      assign mat_product = prod
    else
      assign cabin_product = prod
    endif
  endfor

  if mat_product == blank
    assign mat_product = all_products['sauneras-koko-kehon-punavalo-infrapunahoitopatja-180-80-cm']
  endif
  if cabin_product == blank
    assign cabin_product = collections['all'].products.first
  endif

  assign mat_variant = mat_product.selected_or_first_available_variant
  assign cabin_variant = cabin_product.selected_or_first_available_variant
-%}

<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="valitse-malli">
  <div class="sauneras-container">
    <div class="sauneras-header-center" style="margin-bottom: 32px;">
      <div class="sauneras-badge" style="background: #121212; color: #F79A63; border: 1px solid rgba(247, 154, 99, 0.4);">
        <span class="pulse-dot"></span>
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <!-- Black Friday Dual Announcement -->
    <div class="sauneras-urgency-banner" style="background: linear-gradient(135deg, #141B18 0%, #1F362B 100%); color: #FFFFFF; border-color: #CF6E3C; margin-bottom: 40px;">
      <div class="sauneras-urgency-pill">
        <span class="sauneras-pulse-dot"></span>
        <span><strong>🖤 BLACK FRIDAY -KAMPANJA:</strong> Säästä jopa 400 € • Rajoitettu erä Suomen varastosta</span>
      </div>
      <div class="sauneras-urgency-pill">
        <span>🇫🇮 <strong>Toimitus vain Suomeen:</strong> Ilmainen seurattu toimitus & 30 pv kokeilujakso</span>
      </div>
    </div>

    <!-- Dual Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; align-items: stretch;">

      <!-- CARD 1: PUNAVALOPATJA (199 €) -->
      <div style="background: #FFFFFF; border-radius: 20px; border: 2px solid #CF6E3C; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 12px 36px rgba(0,0,0,0.08); position: relative;">
        <!-- Popular Flag -->
        <div style="background: #CF6E3C; color: #FFFFFF; font-size: 0.8rem; font-weight: 800; text-align: center; padding: 8px 12px; text-transform: uppercase; letter-spacing: 0.06em;">
          ⭐ SUOSITUIN KAAMOKSEEN & ARJEN PALAUTUMISEEN
        </div>

        <!-- Image Container -->
        <div style="position: relative; width: 100%; aspect-ratio: 4 / 3; background: #1a1a1a; overflow: hidden;">
          {%- if mat_product != blank and mat_product.featured_media != blank -%}
            <img 
              src="{{ mat_product.featured_media | image_url: width: 800 }}" 
              alt="{{ mat_product.title | escape }}" 
              width="800" 
              height="600" 
              loading="lazy" 
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- else -%}
            <img 
              src="{{ 'sauneras-redlight-mat-1.jpg' | asset_url }}" 
              alt="Sauneras™ Koko Kehon Punavalopatja" 
              width="800" 
              height="600" 
              loading="lazy" 
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- endif -%}
          <span style="position: absolute; top: 12px; left: 12px; background: #121212; color: #F79A63; border: 1px solid #CF6E3C; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px;">
            🖤 BLACK FRIDAY -43 %
          </span>
          <span style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.75); color: #FFFFFF; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; backdrop-filter: blur(4px);">
            660nm + 850nm DUAL SPECTRUM
          </span>
        </div>

        <!-- Card Body -->
        <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
          <!-- Star reviews -->
          <div style="display: flex; align-items: center; gap: 4px; color: #CF6E3C; margin-bottom: 8px;">
            {%- for i in (1..5) -%}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
            <span style="font-size: 0.85rem; color: #5B6A63; margin-left: 6px; font-weight: 600;">4.9/5 (480+ arvostelua Suomesta)</span>
          </div>

          <!-- Title -->
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #1A2420; margin: 0 0 8px; line-height: 1.3;">
            Sauneras™ Koko Kehon Punavalo- & Infrapunahoitopatja (180 × 80 cm)
          </h3>

          <p style="font-size: 0.9rem; color: #5B6A63; line-height: 1.5; margin: 0 0 16px;">
            Tuo auringon energia kotiisi keskellä kaamosaikaa. Dual-Spectrum 660 nm & 850 nm elvyttää soluja, helpottaa kaamosväsymystä ja lievittää lihas- ja nivelkipuja.
          </p>

          <!-- Price & Savings -->
          <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px;">
            <span style="font-size: 1.85rem; font-weight: 900; color: #1F362B;">
              199,00 €
            </span>
            <span style="font-size: 1.1rem; color: #8F9D96; text-decoration: line-through;">
              349,00 €
            </span>
            <span style="font-size: 0.8rem; font-weight: 800; color: #2E7D32; background: #E8F5E9; padding: 3px 8px; border-radius: 4px;">
              SÄÄSTÄ 150 €
            </span>
          </div>

          <div style="font-size: 0.82rem; color: #5B6A63; margin-bottom: 18px;">
            <span>Tai alkaen <strong>19 €/kk</strong> Klarnalla tai 3 erässä korottomasti</span>
          </div>

          <!-- Feature Bullets -->
          <ul style="list-style: none; padding: 0; margin: 0 0 24px; font-size: 0.88rem; color: #2C3E35; display: flex; flex-direction: column; gap: 8px;">
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Täysi koko kehon 180 × 80 cm peitto:</strong> Käytä sängyllä tai sohvalla</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Dual-Spectrum 660nm + 850nm:</strong> Ihon hehku & syvälihashoito</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Rullattava & kevyt (3,5 kg):</strong> Helppo säilyttää vaatekaapissa</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Kaukosäädin & ajastin:</strong> Pulssitilat (10Hz/40Hz) ja automaattisammutus</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>📦 Ilmainen Posti-paketti:</strong> 2–4 arkipäivässä noutopisteeseen</span>
            </li>
          </ul>

          <!-- CTA Buttons -->
          <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
            {%- if mat_variant != blank -%}
              <a 
                href="/cart/{{ mat_variant.id }}:1" 
                class="sauneras-btn-instant-cart" 
                style="width: 100%; text-align: center; justify-content: center; padding: 14px 20px; font-size: 1rem;"
              >
                Tilaa Punavalopatja (199 €) →
              </a>
            {%- else -%}
              <a 
                href="{{ mat_product.url | default: '/products/sauneras-koko-kehon-punavalo-infrapunahoitopatja-180-80-cm' }}" 
                class="sauneras-btn-instant-cart" 
                style="width: 100%; text-align: center; justify-content: center; padding: 14px 20px; font-size: 1rem;"
              >
                Tilaa Punavalopatja (199 €) →
              </a>
            {%- endif -%}

            {%- if mat_product != blank -%}
              <a 
                href="{{ mat_product.url }}" 
                style="text-align: center; font-size: 0.85rem; color: #1F362B; text-decoration: underline; padding: 6px;"
              >
                Lue täydet tuotetiedot ja katso kuvat →
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- CARD 2: 1350W PUINEN KABINI (599 €) -->
      <div style="background: #FFFFFF; border-radius: 20px; border: 1px solid #D6CEBE; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 12px 36px rgba(0,0,0,0.06); position: relative;">
        <!-- Luxury Flag -->
        <div style="background: #1F362B; color: #FFFFFF; font-size: 0.8rem; font-weight: 800; text-align: center; padding: 8px 12px; text-transform: uppercase; letter-spacing: 0.06em;">
          👑 YLELLINEN KOTIKYLPYLÄ ILMAN REMONTTIA
        </div>

        <!-- Image Container -->
        <div style="position: relative; width: 100%; aspect-ratio: 4 / 3; background: #EFEBE4; overflow: hidden;">
          {%- if cabin_product != blank and cabin_product.featured_media != blank -%}
            <img 
              src="{{ cabin_product.featured_media | image_url: width: 800 }}" 
              alt="{{ cabin_product.title | escape }}" 
              width="800" 
              height="600" 
              loading="lazy" 
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- else -%}
            <img 
              src="{{ 'sauneras-logo.svg' | asset_url }}" 
              alt="Sauneras™ 1350W Puusauna" 
              width="800" 
              height="600" 
              loading="lazy" 
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- endif -%}
          <span style="position: absolute; top: 12px; left: 12px; background: #121212; color: #F79A63; border: 1px solid #CF6E3C; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px;">
            🖤 BLACK FRIDAY -40 %
          </span>
          <span style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.75); color: #FFFFFF; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; backdrop-filter: blur(4px);">
            1350W • LUONNONPUU
          </span>
        </div>

        <!-- Card Body -->
        <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
          <!-- Star reviews -->
          <div style="display: flex; align-items: center; gap: 4px; color: #CF6E3C; margin-bottom: 8px;">
            {%- for i in (1..5) -%}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
            <span style="font-size: 0.85rem; color: #5B6A63; margin-left: 6px; font-weight: 600;">4.9/5 (320+ arvostelua Suomesta)</span>
          </div>

          <!-- Title -->
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #1A2420; margin: 0 0 8px; line-height: 1.3;">
            Sauneras™ — 1350 W Luonnollinen Puinen Kaukoinfrapunasauna
          </h3>

          <p style="font-size: 0.9rem; color: #5B6A63; line-height: 1.5; margin: 0 0 16px;">
            Aito luonnonpuinen infrapunasaunakabiini kotiisi. 1350 W:n kaukoinfrapunalämpö tuottaa syväpuhdistavan hien ja rentoutuksen ilman kylpyhuoneremonttia tai voimavirtaa.
          </p>

          <!-- Price & Savings -->
          <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px;">
            <span style="font-size: 1.85rem; font-weight: 900; color: #1F362B;">
              599,00 €
            </span>
            <span style="font-size: 1.1rem; color: #8F9D96; text-decoration: line-through;">
              999,00 €
            </span>
            <span style="font-size: 0.8rem; font-weight: 800; color: #2E7D32; background: #E8F5E9; padding: 3px 8px; border-radius: 4px;">
              SÄÄSTÄ 400 €
            </span>
          </div>

          <div style="font-size: 0.82rem; color: #5B6A63; margin-bottom: 18px;">
            <span>Tai alkaen <strong>49 €/kk</strong> Klarnalla tai erissä</span>
          </div>

          <!-- Feature Bullets -->
          <ul style="list-style: none; padding: 0; margin: 0 0 24px; font-size: 0.88rem; color: #2C3E35; display: flex; flex-direction: column; gap: 8px;">
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Aito luonnonpuukabiini:</strong> Kaunis pohjoismainen design & lasiovi</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>1350 W kaukoinfrapunalämpö:</strong> Syväpuhdistava hiki & detox</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Ei remonttia tai putkitöitä:</strong> Kytketään tavalliseen 230V pistorasiaan</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>Energiapihi:</strong> Vain n. 0,15–0,25 € per saunakerta</span>
            </li>
            <li style="display: flex; align-items: center; gap: 8px;">
              <span style="color: #2E7D32; font-weight: bold;">✓</span>
              <span><strong>🚚 Ilmainen kotiinkuljetus:</strong> Seurattu rahtikuljetus kotiovelle</span>
            </li>
          </ul>

          <!-- CTA Buttons -->
          <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
            {%- if cabin_variant != blank -%}
              <a 
                href="/cart/{{ cabin_variant.id }}:1" 
                class="sauneras-btn-instant-cart" 
                style="width: 100%; text-align: center; justify-content: center; padding: 14px 20px; font-size: 1rem; background: #1F362B;"
              >
                Tilaa Puusauna (599 €) →
              </a>
            {%- else -%}
              <a 
                href="{{ cabin_product.url | default: '/collections/all' }}" 
                class="sauneras-btn-instant-cart" 
                style="width: 100%; text-align: center; justify-content: center; padding: 14px 20px; font-size: 1rem; background: #1F362B;"
              >
                Tilaa Puusauna (599 €) →
              </a>
            {%- endif -%}

            {%- if cabin_product != blank -%}
              <a 
                href="{{ cabin_product.url }}" 
                style="text-align: center; font-size: 0.85rem; color: #1F362B; text-decoration: underline; padding: 6px;"
              >
                Lue täydet tuotetiedot ja katso mitat →
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>

    <!-- Trust Badges & Guarantee Row -->
    <div style="margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; background: #F8F6F2; padding: 24px; border-radius: 16px; border: 1px solid #ECE7E1; text-align: center;">
      <div>
        <div style="font-size: 1.5rem; margin-bottom: 6px;">🇫🇮</div>
        <div style="font-weight: 700; color: #1A2420; font-size: 0.95rem;">Toimitus Vain Suomeen</div>
        <div style="font-size: 0.82rem; color: #5B6A63; margin-top: 2px;">Ilmainen Postin tai rahdin toimitus</div>
      </div>
      <div>
        <div style="font-size: 1.5rem; margin-bottom: 6px;">🛡️</div>
        <div style="font-weight: 700; color: #1A2420; font-size: 0.95rem;">30 Päivän Kotikokeilu</div>
        <div style="font-size: 0.82rem; color: #5B6A63; margin-top: 2px;">100 % rahat takaisin -takuu</div>
      </div>
      <div>
        <div style="font-size: 1.5rem; margin-bottom: 6px;">💳</div>
        <div style="font-weight: 700; color: #1A2420; font-size: 0.95rem;">Joustavat Maksutavat</div>
        <div style="font-size: 0.82rem; color: #5B6A63; margin-top: 2px;">Klarna, MobilePay, Verkkopankki</div>
      </div>
      <div>
        <div style="font-size: 1.5rem; margin-bottom: 6px;">⚡</div>
        <div style="font-weight: 700; color: #1A2420; font-size: 0.95rem;">Vakio 230V Pistoke</div>
        <div style="font-size: 0.82rem; color: #5B6A63; margin-top: 2px;">Ei vaadi sähkö- tai putkiremonttia</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sauneras Dual Flagships",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "🖤 VIRALLINEN BLACK FRIDAY -MALLISTO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Valitse Sauneras™ Hyvinvointiratkaisusi"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Molemmat mallit hyödyntävät tutkittua syvälämpöä ja valoterapiaa kehon palautumiseen, unen parantamiseen ja kaamosväsymyksen lievitykseen."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Sauneras Dual Flagships"
    }
  ]
}
{% endschema %}
