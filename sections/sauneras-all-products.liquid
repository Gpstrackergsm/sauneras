<section class="sauneras-section color-{{ section.settings.color_scheme }}" id="all-products">
  <div class="sauneras-container">
    <div class="sauneras-header-center" style="margin-bottom: 24px;">
      <div class="sauneras-badge sauneras-badge-green">
        {{ section.settings.sub_heading }}
      </div>
      <h2 class="sauneras-section-title">{{ section.settings.heading }}</h2>
      <p class="sauneras-section-desc">{{ section.settings.description }}</p>
    </div>

    <!-- Live Urgency & Value Stacking Bar -->
    <div class="sauneras-urgency-banner">
      <div class="sauneras-urgency-pill">
        <span class="sauneras-pulse-dot"></span>
        <span><strong>FLASH SALE ACTIVE:</strong> Up to 35% OFF Storewide</span>
      </div>
      <div class="sauneras-urgency-pill">
        <span>🚚 <strong>Free Tracked Express Shipping:</strong> In Stock for Immediate Dispatch</span>
      </div>
      <div class="sauneras-urgency-pill">
        <span>🛡️ <strong>30-Day Risk-Free In-Home Sweat Trial:</strong> 100% Money-Back Guarantee</span>
      </div>
    </div>

    <!-- Interactive Category Filter Bar -->
    <div class="sauneras-filter-bar">
      <button type="button" class="sauneras-filter-btn active" data-filter="all">
        All Models
      </button>
      <button type="button" class="sauneras-filter-btn" data-filter="steam">
        💨 Steam Saunas
      </button>
      <button type="button" class="sauneras-filter-btn" data-filter="infrared">
        ⚡ Infrared & Red Light
      </button>
      <button type="button" class="sauneras-filter-btn" data-filter="twoperson">
        👥 2-Person Saunas
      </button>
      <button type="button" class="sauneras-filter-btn" data-filter="accessories">
        🌡️ Accessories & Gauges
      </button>
    </div>

    {%- assign target_collection = section.settings.collection | default: collections['all'] -%}
    {%- assign product_limit = section.settings.products_to_show | default: 50 -%}

    <!-- Product Grid -->
    <div class="sauneras-product-grid" id="saunerasProductGrid">
      {%- if target_collection.products.size > 0 -%}
        {%- for product in target_collection.products limit: product_limit -%}
          {%- liquid
            assign p_type = product.type | downcase
            assign p_title = product.title | downcase
            if p_type contains 'infrared' or p_title contains 'infrared' or p_title contains 'red light'
              assign cat = 'infrared'
              assign spec_tag = '660nm/850nm Red Light'
              assign badge_text = 'POPULAR'
            elsif p_type contains '2-person' or p_title contains '2 person' or p_title contains 'two person'
              assign cat = 'twoperson'
              assign spec_tag = 'Dual Chair Capacity'
              assign badge_text = 'COUPLES PICK'
            elsif p_type contains 'thermometer' or p_title contains 'thermometer' or p_title contains 'hygrometer'
              assign cat = 'accessories'
              assign spec_tag = 'Precision 2-in-1 Gauge'
              assign badge_text = 'ESSENTIAL'
            else
              assign cat = 'steam'
              assign spec_tag = 'Foldable Chair Included'
              assign badge_text = 'BESTSELLER'
            endif
          -%}

          <div class="sauneras-product-card" data-category="{{ cat }}">
            <!-- Media thumbnail wrap -->
            <div class="sauneras-card-media-wrap">
              <span class="sauneras-card-badge">{{ badge_text }}</span>
              <span class="sauneras-card-specs">{{ spec_tag }}</span>

              {%- if product.featured_media != blank -%}
                <img 
                  src="{{ product.featured_media | image_url: width: 800 }}" 
                  alt="{{ product.title | escape }}" 
                  width="800" 
                  height="800" 
                  loading="lazy" 
                  class="sauneras-card-img"
                >
              {%- else -%}
                <img 
                  src="https://m.media-amazon.com/images/I/71wAOO+FF1L._AC_SL1500_.jpg" 
                  alt="{{ product.title | escape }}" 
                  width="800" 
                  height="800" 
                  loading="lazy" 
                  class="sauneras-card-img"
                >
              {%- endif -%}
            </div>

            <!-- Content Details -->
            <div class="sauneras-card-body">
              <div class="sauneras-card-stock-notice">
                <span class="sauneras-stock-indicator"></span>
                <span>In Stock • Ready for Same-Day Dispatch</span>
              </div>

              <div class="sauneras-card-rating">
                <span class="stars">★★★★★</span>
                <span class="reviews-count">4.9/5.0 (Verified Buyer Reviews)</span>
              </div>

              <h3 class="sauneras-product-title">
                {{ product.title }}
              </h3>

              <!-- Pricing Box -->
              <div class="sauneras-pricing-row">
                <span class="sauneras-price-current">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="sauneras-price-compare">{{ product.compare_at_price | money }}</span>
                  <span class="sauneras-savings-tag">
                    SAVE {{ product.compare_at_price | minus: product.price | money }}
                  </span>
                {%- endif -%}
              </div>

              <!-- Value Package Checklist -->
              <div class="sauneras-card-features">
                <div class="sauneras-feature-point">✓ Multi-Layer Insulated Thermal Tent</div>
                <div class="sauneras-feature-point">✓ Reinforced Folding Spa Chair Included</div>
                <div class="sauneras-feature-point">✓ 30-Day Risk-Free Money Back Guarantee</div>
              </div>

              <!-- Dual Action Buttons -->
              <div class="sauneras-card-actions">
                {%- assign current_variant = product.selected_or_first_available_variant -%}
                <button 
                  type="button" 
                  class="sauneras-btn-instant-cart"
                  onclick="saunerasDirectAdd({{ current_variant.id }}, this)"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span>Add to Cart & Checkout</span>
                </button>

                <a href="{{ product.url }}" class="sauneras-btn-details-link">
                  <span>View Full Details & Specs →</span>
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div 
            class="sauneras-product-card" 
            data-category="{{ block.settings.category }}"
            {{ block.shopify_attributes }}
          >
            <div class="sauneras-card-media-wrap">
              {%- if block.settings.badge != blank -%}
                <span class="sauneras-card-badge">{{ block.settings.badge }}</span>
              {%- endif -%}

              {%- if block.settings.specs != blank -%}
                <span class="sauneras-card-specs">{{ block.settings.specs }}</span>
              {%- endif -%}

              {%- if block.settings.image_url != blank -%}
                <img 
                  src="{{ block.settings.image_url }}" 
                  alt="{{ block.settings.title | escape }}" 
                  width="800" 
                  height="800" 
                  loading="lazy" 
                  class="sauneras-card-img"
                >
              {%- endif -%}
            </div>

            <div class="sauneras-card-body">
              <div class="sauneras-card-stock-notice">
                <span class="sauneras-stock-indicator"></span>
                <span>In Stock • Ready for Same-Day Dispatch</span>
              </div>

              <div class="sauneras-card-rating">
                <span class="stars">★★★★★</span>
                <span class="reviews-count">4.9/5.0 (Verified Buyer Reviews)</span>
              </div>

              <h3 class="sauneras-product-title">
                {{ block.settings.title }}
              </h3>

              <div class="sauneras-pricing-row">
                <span class="sauneras-price-current">{{ block.settings.price }}</span>
                {%- if block.settings.compare_price != blank -%}
                  <span class="sauneras-price-compare">{{ block.settings.compare_price }}</span>
                  <span class="sauneras-savings-tag">SAVE {{ block.settings.savings }}</span>
                {%- endif -%}
              </div>

              <div class="sauneras-card-features">
                <div class="sauneras-feature-point">✓ Multi-Layer Insulated Thermal Tent</div>
                <div class="sauneras-feature-point">✓ Reinforced Folding Spa Chair Included</div>
                <div class="sauneras-feature-point">✓ 30-Day Risk-Free Money Back Guarantee</div>
              </div>

              <div class="sauneras-card-actions">
                {%- assign product_url = '/products/' | append: block.settings.handle -%}
                <a href="{{ block.settings.custom_link | default: product_url }}" class="sauneras-btn-instant-cart" style="text-decoration: none;">
                  <span>Add to Cart & Checkout</span>
                </a>
                <a href="{{ block.settings.custom_link | default: product_url }}" class="sauneras-btn-details-link">
                  <span>View Full Details & Specs →</span>
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Bottom Trust & Safe Checkout Bar -->
    <div class="sauneras-checkout-trust-bar">
      <div class="sauneras-trust-pillar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2D7A4D" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div>
          <strong>30-Day Sweat Trial</strong>
          <p>Full 100% refund if not satisfied</p>
        </div>
      </div>
      <div class="sauneras-trust-pillar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2D7A4D" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        <div>
          <strong>Free Express Shipping</strong>
          <p>Tracked delivery right to your door</p>
        </div>
      </div>
      <div class="sauneras-trust-pillar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2D7A4D" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <div>
          <strong>256-Bit SSL Checkout</strong>
          <p>Visa, MasterCard, PayPal, Apple Pay</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  async function saunerasDirectAdd(variantId, btn) {
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span>Adding...</span>';
    btn.disabled = true;
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      });
      if (!res.ok) throw new Error('Cart add failed');

      btn.innerHTML = '<span>✓ Added to Cart!</span>';
      
      const cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) {
        const drawerRes = await fetch('/?section_id=cart-drawer');
        const text = await drawerRes.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');
        const newDrawerInner = doc.querySelector('#CartDrawer');
        const currentDrawerInner = document.querySelector('#CartDrawer');
        if (newDrawerInner && currentDrawerInner) {
          currentDrawerInner.innerHTML = newDrawerInner.innerHTML;
        }
        cartDrawer.open();
      } else {
        window.location.href = '/cart';
      }
    } catch (e) {
      console.log('Error adding to cart:', e);
      window.location.href = '/cart';
    } finally {
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 2500);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('.sauneras-filter-btn');
    const productCards = document.querySelectorAll('.sauneras-product-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        filterButtons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        const selectedFilter = this.getAttribute('data-filter');

        productCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedFilter === 'all' || cardCat === selectedFilter) {
            card.style.display = 'flex';
            card.style.opacity = '0';
            setTimeout(() => {
              card.style.transition = 'opacity 0.3s ease';
              card.style.opacity = '1';
            }, 10);
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Sauneras All Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Small Subtitle",
      "default": "COMPLETE 2026 CATALOG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore All 28 Sauneras™ Home Spa Models"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select your ideal at-home thermal sanctuary below. All units feature medical-grade safety, fast multi-level heat control, free express delivery, and our 30-day in-home risk-free trial."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Source (Defaults to All)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 30,
      "label": "Maximum Products to Show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Fallback",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price"
        },
        {
          "type": "text",
          "id": "savings",
          "label": "Savings Text"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category Tab",
          "options": [
            { "value": "steam", "label": "Steam Sauna" },
            { "value": "infrared", "label": "Infrared & Red Light" },
            { "value": "twoperson", "label": "2-Person Sauna" },
            { "value": "accessories", "label": "Accessories & Gauges" }
          ],
          "default": "steam"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "TOP RATED"
        },
        {
          "type": "text",
          "id": "specs",
          "label": "Key Spec Tag",
          "default": "Rapid Heat-Up"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (High-Res)"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Product Handle"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sauneras All Products"
    }
  ]
}
{% endschema %}
